{
  "screens": {
    "home_screen": {
      "header": {
        "search_bar": {
          "enabled": true,
          "placeholder": "Pesquisar notas...",
          "debounce": 300
        }
      },
      "performance": {
        "lazy_loading": true,
        "caching": {
          "enabled": true,
          "strategy": "memory"
        }
      }
    },
    "dependencies": {
      "flutter_bloc": "^8.1.3",
      "cached_network_image": "^3.3.0",
      "search_choices": "^2.5.0"
    },
    "workflows": {
      "build": {
        "minify": true,
        "optimize": true,
        "strip": true
      }
    }
  }
}