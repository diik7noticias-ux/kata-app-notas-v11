{
  "screens": [
    {
      "name": "home_screen",
      "tabs": [
        {
          "label": "Notas",
          "route": "/home"
        },
        {
          "label": "Financeiro",
          "route": "/finance",
          "icon": "attach_money"
        }
      ]
    },
    {
      "name": "finance_screen",
      "layout": {
        "header": "Gestão Financeira",
        "sections": [
          {
            "type": "form",
            "widget": "transaction_form",
            "fields": [
              "quantia",
              "destino",
              "data"
            ]
          },
          {
            "type": "list",
            "widget": "transaction_list",
            "sort": "data_desc"
          }
        ]
      }
    }
  ],
  "widgets": {
    "transaction_form": {
      "fields": {
        "quantia": {
          "type": "number",
          "label": "Valor",
          "required": true
        },
        "destino": {
          "type": "text",
          "label": "Destino",
          "required": true
        },
        "data": {
          "type": "date",
          "label": "Data",
          "default": "today"
        }
      },
      "actions": [
        "salvar",
        "cancelar"
      ]
    },
    "transaction_list": {
      "columns": [
        "data",
        "destino",
        "valor",
        "tipo"
      ],
      "filters": [
        "entrada",
        "saida"
      ]
    }
  },
  "theme": {
    "finance": {
      "primaryColor": "#4CAF50",
      "secondaryColor": "#8BC34A",
      "textColor": "#333"
    }
  }
}